# --- required ---
GEMINI_API_KEY=
# --- optional ---
# GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash-lite
PORT=8787
# Hard cap on Gemini calls per day for the whole server (cost protection)
DAILY_AI_CALL_LIMIT=4000
FREE_CHATS_PER_DAY=5
PLUS_CHATS_PER_DAY=50
# --- Plus verification (RevenueCat > Project settings > API keys > Secret key) ---
REVENUECAT_SECRET_KEY=
# Where the per-install question counters are kept (use a persistent disk path if your host has one)
# DATA_DIR=/data
# Local testing ONLY: trust the app's own claim of being Plus. Never enable in production.
# DEV_TRUST_PLUS=1
# --- app update prompt: bump LATEST_VERSION after each Play release; MIN_VERSION forces an update ---
LATEST_VERSION=1.0.0
MIN_VERSION=1.0.0
# --- Free hosts without a disk (Render free): Upstash Redis keeps the counters across restarts ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
